# Local development ONLY. Never deploy demo accounts or DEV_INTEGRATIONS.
DATABASE_URL=postgresql://aura:aura_local_only@localhost:5434/aura?schema=public
NODE_ENV=development
DEV_INTEGRATIONS=true
PORT=4000
HOST=127.0.0.1
ADMIN_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:3100,http://localhost:5173
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3100
VITE_API_URL=http://localhost:4000/api
VITE_PUBLIC_URL=http://localhost:3100
# Provider settings documented in apps/api/README.md; supply in production secrets.

# Optional direct Cloudflare R2 (leave unset for local development)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# Pini-compatible translation via OpenRouter (server-side only).
# OPENROUTER_API_KEY=
# CHAT_MODEL=google/gemini-2.5-flash

# Optional OpenAI fallback when OpenRouter is not configured; webhook takes precedence
# OPENAI_API_KEY=
# OPENAI_TRANSLATION_MODEL=gpt-4.1-mini
