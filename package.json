{
  "name": "aura-property",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "node scripts/env.mjs npm exec -w @aura/web -- next dev -p 3100",
    "dev:api": "node scripts/env.mjs npm run dev -w @aura/api",
    "dev:admin": "node scripts/env.mjs npm run dev -w @aura/admin",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node scripts/env.mjs npm run test --workspaces --if-present",
    "db:generate": "node scripts/env.mjs npm run generate -w @aura/database",
    "db:migrate": "node scripts/env.mjs npm exec -w @aura/database -- prisma migrate dev",
    "db:seed": "node scripts/env.mjs npm run seed -w @aura/database",
    "dev": "node scripts/dev.mjs",
    "setup": "node scripts/setup.mjs",
    "format": "prettier --write apps packages scripts docs tasks",
    "owner:init": "node scripts/env.mjs npm exec -w @aura/api -- tsx src/bootstrap.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
