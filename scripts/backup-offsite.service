[Unit]
Description=Aura encrypted off-host PostgreSQL backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/aura
Environment=AURA_ENV_FILE=/opt/aura/.env.production.local
Environment=AURA_BACKUP_DIR=/var/backups/aura
ExecStart=/usr/bin/bash /opt/aura/scripts/backup-offsite-run.sh
UMask=0077
Nice=10
TimeoutStartSec=1h
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/backups/aura
