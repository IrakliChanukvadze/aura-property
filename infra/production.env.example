# auraproperty.ge proposed production inputs — TEMPLATE ONLY.
# Copy to an ignored, access-restricted deployment secret file or provider secrets.
# Blank secrets require real values before deployment. Never use the local .env.

# API runtime
NODE_ENV=production
DEV_INTEGRATIONS=false
HOST=0.0.0.0
PORT=4000
DATABASE_URL=
ADMIN_URL=https://admin.auraproperty.ge
ALLOWED_ORIGINS=https://auraproperty.ge,https://www.auraproperty.ge,https://admin.auraproperty.ge

# Public build arguments — these are deliberately NOT secrets.
NEXT_PUBLIC_API_URL=https://api.auraproperty.ge/api
NEXT_PUBLIC_SITE_URL=https://auraproperty.ge
VITE_API_URL=https://api.auraproperty.ge/api
VITE_PUBLIC_URL=https://auraproperty.ge

# Pini-compatible AI translation. Use your OpenRouter billing account.
# An Aura-specific key can have its own monthly limit; a shared key shares usage.
OPENROUTER_API_KEY=
CHAT_MODEL=google/gemini-2.5-flash

# Optional alternative when OpenRouter is unset:
# OPENAI_API_KEY=
# OPENAI_TRANSLATION_MODEL=gpt-4.1-mini
# Alternative compatible translation relay (takes precedence over direct providers):
# TRANSLATION_WEBHOOK_URL=
# TRANSLATION_WEBHOOK_TOKEN=

# Private Cloudflare R2 object storage (bucket-scoped access).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Transactional email via Resend (verify auraproperty.ge and key domain scope).
RESEND_API_KEY=
EMAIL_FROM="Aura Property <notifications@auraproperty.ge>"
# Optional compatible email relay; takes precedence over Resend.
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=

# SMS provider adapter or compatible relay remains to configure.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# Optional FX provider; otherwise maintain verified rates in Settings.
# FX_WEBHOOK_URL=

# One-time owner initialization only: use a real private email, no demo password.
# OWNER_EMAIL=
# OWNER_NAME=
